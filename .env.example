NEBIUS_API_KEY=replace-with-token-factory-key
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEMOTRON_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
NEMOTRON_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b
